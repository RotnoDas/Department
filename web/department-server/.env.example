PORT=5000
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/department_db?appName=Cluster0
DB_NAME=department_db

# ── Face verification microservice (ml/face-service) ──────────────────────────
FACE_SERVICE_URL=http://127.0.0.1:8001
# Must be identical to FACE_SERVICE_SECRET in ml/face-service/.env
FACE_SERVICE_SECRET=change-me-same-value-as-face-service

# ── Attendance rules (all optional; these are the defaults) ───────────────────
# Time zone used to decide when a class starts. IANA name.
# CLASS_TIMEZONE=Asia/Dhaka
# Minutes after a class starts during which students can give attendance.
# ATTENDANCE_WINDOW_MINUTES=10
# Maximum distance (meters) from the classroom.
# ATTENDANCE_RADIUS_METERS=10
# GPS fixes less accurate than this (meters) are rejected.
# ATTENDANCE_MAX_GPS_ACCURACY_METERS=30
# Classroom coordinates as JSON. Defaults to the PUST CSE building.
# ATTENDANCE_LOCATIONS=[{"id":"cse-407","name":"Room 407","lat":24.01296,"lon":89.280835}]
# Failed liveness/identity checks allowed per class before a temporary lock-out.
# FACE_MAX_FAILED_ATTEMPTS=5
# Comma-separated e-mails allowed to reset a student's face enrollment.
# ADMIN_EMAILS=admin@cse.edu

# Local testing only. Opens test windows and relaxes the 10 m check (face checks are never skipped).
# Ignored when NODE_ENV=production. Must be false for real use.
ATTENDANCE_DEV_MODE=false
